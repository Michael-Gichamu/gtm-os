{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Pure TS + zod — no ambient libs. Prevents TS from auto-scanning the
    // hoisted node_modules/@types folder (which pulls in broken transitive
    // type packages like @types/send via express).
    "types": []
  },
  "include": ["src/**/*"]
}
