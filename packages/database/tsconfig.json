{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Only node globals (process, globalThis) are needed. Scoping `types`
    // stops TS from auto-including the whole hoisted @types folder, which
    // pulls in broken transitive packages like @types/send.
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
