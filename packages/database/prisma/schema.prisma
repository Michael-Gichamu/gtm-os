// ============================================================================
// GTM-OS database schema
//
// Design principles:
//   - Entity-agnostic: a Lead is a Company + primary Contact, never a "clinic".
//     Niche logic (templates, scoring) lives in application code, not the DB.
//   - Workspace-scoped: every business entity carries workspaceId for
//     multi-tenancy from day one. Phase 1 ships one workspace per user; later
//     phases (teams, agencies) inherit the model without migration pain.
//   - Event log first-class: Activity captures every state change so the
//     analytics + AI phases can replay history without bolting on a parallel
//     stream later.
//   - Configurable pipeline: PipelineStage is a row, not an enum — operators
//     reorder/rename stages without schema changes.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth (NextAuth Prisma Adapter shape)
// ----------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  image          String?
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  memberships    WorkspaceMember[]
  authoredNotes  Note[]    @relation("NoteAuthor")
  activities     Activity[] @relation("ActivityActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------------
// Tenancy
// ----------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        WorkspaceMember[]
  leads          Lead[]
  tags           Tag[]
  pipelineStages PipelineStage[]
  activities     Activity[]
  campaigns      Campaign[]
  enrollments    CampaignEnrollment[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// CRM core
// ----------------------------------------------------------------------------

model PipelineStage {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  // Ordering position within the pipeline (0-based).
  position     Int
  // Soft semantic so analytics can group regardless of name.
  // OPEN = active, WON = closed-won, LOST = closed-lost.
  semantic     StageSemantic @default(OPEN)
  color        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

enum StageSemantic {
  OPEN
  WON
  LOST
}

model Lead {
  id           String   @id @default(cuid())
  workspaceId  String

  // ---------- Universal company fields ----------
  companyName  String
  industry     String?
  website      String?
  country      String?
  city         String?

  // ---------- Primary contact (denormalized for list-view speed) ----------
  contactName  String?
  role         String?
  email        String?
  phone        String?
  linkedinUrl  String?

  // ---------- Outbound state ----------
  pipelineStageId String?
  source          String?  // e.g. "manual", "google-maps", "csv"
  personalization String?  @db.Text
  notesSummary    String?  @db.Text

  // ---------- Confidence + engagement ----------
  // 0-100. Phase 6 enrichment writes this; Phase 1 leaves it null.
  confidenceScore  Int?
  lastContactedAt  DateTime?
  lastOpenedAt     DateTime?
  lastRepliedAt    DateTime?

  // ---------- Bookkeeping ----------
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelineStage PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  tags          LeadTag[]
  notes         Note[]
  activities    Activity[]
  enrollments   CampaignEnrollment[]

  // Email uniqueness is per-workspace, not global, and only when present.
  @@unique([workspaceId, email])
  @@index([workspaceId, pipelineStageId])
  @@index([workspaceId, industry])
  @@index([workspaceId, createdAt])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     LeadTag[]

  @@unique([workspaceId, name])
}

model LeadTag {
  leadId String
  tagId  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

// ----------------------------------------------------------------------------
// Event log (the spine the event-driven architecture rides on)
// ----------------------------------------------------------------------------

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  leadId      String?
  actorUserId String?
  type        ActivityType
  // Free-form payload describing the event. Each ActivityType has a known
  // shape (see packages/shared/activity.ts), but the column stays flexible.
  payload     Json?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([leadId, createdAt])
  @@index([type, createdAt])
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_STAGE_CHANGED
  LEAD_TAGGED
  LEAD_UNTAGGED
  LEAD_DELETED
  NOTE_ADDED
  // Campaign events (Phase 2). EMAIL_SENT covers both stubbed (Phase 2)
  // and real (Phase 3) sends; the payload carries a `stubbed: true` flag
  // while Phase 3 isn't live.
  LEAD_ENROLLED
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  REPLY_RECEIVED
  BOUNCE_RECEIVED
  CAMPAIGN_STARTED
  CAMPAIGN_COMPLETED
  FOLLOWUP_SCHEDULED
  FOLLOWUP_SENT
}

// ----------------------------------------------------------------------------
// Campaigns (Phase 2 — outbound sequence engine)
//
// A Campaign is a named outbound effort owned by a workspace, containing an
// ordered list of SequenceSteps (each a templated email with a delay from
// the prior step). Leads enroll via CampaignEnrollment, which is the
// per-lead state machine the BullMQ worker advances.
// ----------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT     // being built; sequence not yet active
  ACTIVE    // running; worker advances enrolled leads
  PAUSED    // worker skips; existing enrollments hold position
  ARCHIVED  // read-only history
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  description String?        @db.Text
  status      CampaignStatus @default(DRAFT)

  // Send-window + throttling settings (UTC for Phase 2; per-lead timezone
  // awareness lands in Phase 3 with real Gmail integration).
  dailyCap         Int     @default(50)   // max sends per day across this campaign
  sendWindowStart  Int     @default(9)    // hour 0-23
  sendWindowEnd    Int     @default(17)
  jitterMinutes    Int     @default(30)   // randomization +/- minutes between sends
  stopOnReply      Boolean @default(true) // future-Phase-4 behaviour; flag stored now

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  archivedAt DateTime?

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps       SequenceStep[]
  enrollments CampaignEnrollment[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
}

model SequenceStep {
  id          String   @id @default(cuid())
  campaignId  String
  // 0-based order within the campaign. First step has order=0 and delayDays=0.
  order       Int
  subject     String
  body        String   @db.Text
  // Days after the previous step's send before this step fires. The first
  // step's delay is from enrollment (typically 0 = send immediately).
  delayDays   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, order])
  @@index([campaignId])
}

enum EnrollmentStatus {
  ENROLLED         // queued, waiting for first send
  ACTIVE           // mid-sequence, more steps to come
  PAUSED           // operator paused; worker skips
  COMPLETED        // all steps successfully sent
  STOPPED_ON_REPLY // Phase 4: stopped because the lead replied
  STOPPED_MANUAL   // operator manually stopped
  BOUNCED          // Phase 3: stopped because a send hard-bounced
}

model CampaignEnrollment {
  id           String           @id @default(cuid())
  workspaceId  String
  campaignId   String
  leadId       String

  // Index into the campaign's ordered steps. 0 = first step not yet sent.
  currentStep  Int              @default(0)
  // When the worker should next attempt to advance this enrollment. Null
  // until the first scheduling pass picks it up.
  nextSendAt   DateTime?
  status       EnrollmentStatus @default(ENROLLED)

  enrolledAt   DateTime         @default(now())
  lastSentAt   DateTime?
  completedAt  DateTime?
  pausedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // A lead can be enrolled in a campaign at most once at a time.
  @@unique([campaignId, leadId])
  @@index([workspaceId, status])
  // The scheduler's hot path: find due enrollments cheaply.
  @@index([status, nextSendAt])
}
