# ============================================================================
# GTM-OS local environment
# Copy to .env at the monorepo root. Apps read from this single file.
# ============================================================================

# --- Database ----------------------------------------------------------------
# Generate a strong, URL-safe password:  openssl rand -hex 16
# Put the SAME value in POSTGRES_PASSWORD and inside DATABASE_URL (they must
# match). Use hex so no URL-encoding is needed in the connection string.
POSTGRES_USER=gtm
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_16
POSTGRES_DB=gtm_os
DATABASE_URL=postgresql://gtm:REPLACE_WITH_openssl_rand_hex_16@localhost:5432/gtm_os?schema=public

# --- Redis (reserved for Phase 2: BullMQ) ------------------------------------
REDIS_URL=redis://localhost:6379

# --- API service -------------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000

# --- Web service -------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Auth (NextAuth + cross-service JWT) -------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_me_with_a_long_random_string
NEXTAUTH_URL=http://localhost:3000

# Shared HS256 secret used by web -> api JWT bridge.
# Generate with: openssl rand -base64 64
INTERNAL_JWT_SECRET=replace_me_with_a_longer_random_string

# --- Google OAuth (NextAuth provider) ----------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Observability -----------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
